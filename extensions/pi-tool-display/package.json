    "pi-nested-instructions": "0.1.0",
    "pi-read": "0.1.0",
    "pi-subagents": "0.1.0",
    "pi-todo": "0.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
