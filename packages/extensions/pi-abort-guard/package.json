{
  "name": "pi-abort-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Requires a second interrupt press to stop a busy Pi session",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "lint": "vp lint --format stylish .",
    "check": "vp fmt --check . && vp run lint",
    "test": "vp test run --config ../../../vite.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@pi-mono/libs": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:pi-host",
    "@earendil-works/pi-tui": "catalog:pi-host"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
