{
  "name": "pi-fff-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Block FFF searches targeting Git-ignored or missing explicit paths",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "lint": "vp lint --format stylish .",
    "check": "vp fmt --check . && vp run lint",
    "test": "vp test run"
  },
  "dependencies": {
    "@pi-mono/utils": "workspace:*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
