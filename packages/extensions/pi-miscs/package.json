{
  "name": "pi-miscs",
  "version": "0.1.0",
  "private": true,
  "description": "Small, single-file Pi extensions bundled in one package",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "lint": "vp lint --format stylish .",
    "check": "vp fmt --check . && vp run lint",
    "test": "vp test run --passWithNoTests"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:pi-host"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
