{
  "name": "pi-null-args",
  "version": "0.1.0",
  "private": true,
  "description": "Drops optional tool arguments that a model sent as the text \"null\"",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "lint": "vp lint --format stylish .",
    "check": "vp fmt --check . && vp run lint",
    "test": "vp test run"
  },
  "devDependencies": {
    "@pi-mono/libs": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:pi-host"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
