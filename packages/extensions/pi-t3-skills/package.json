{
  "name": "pi-t3-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Skill references instead of skill contents for T3 Code skill chips in Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "lint": "vp lint --format stylish .",
    "check": "vp fmt --check . && vp run lint",
    "test": "vp test run --config ../../../vite.config.ts"
  },
  "dependencies": {
    "@pi-mono/libs": "workspace:*",
    "@pi-mono/utils": "workspace:*"
  },
  "devDependencies": {
    "pi-skills": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:pi-host"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
