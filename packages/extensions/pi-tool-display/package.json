{
  "name": "pi-tool-display",
  "version": "0.1.0",
  "private": true,
  "description": "Compact, borderless tool activity rendering for pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./renderers": "./src/rendering/api.ts",
    "./adapters": "./src/adapters/index.ts",
    "./viewer": "./src/viewer/index.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "lint": "vp lint --format stylish .",
    "check": "vp fmt --check . && vp run lint",
    "test": "vp test run",
    "validate:terminal": "node validation/launch-terminal.ts"
  },
  "dependencies": {
    "@pi-mono/libs": "workspace:*",
    "@pi-mono/utils": "workspace:*",
    "pi-nested-instructions": "workspace:*",
    "pi-read": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "catalog:pi-host",
    "@earendil-works/pi-coding-agent": "catalog:pi-host",
    "@earendil-works/pi-tui": "catalog:pi-host"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
